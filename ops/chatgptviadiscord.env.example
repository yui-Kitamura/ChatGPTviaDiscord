DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BOT_STARTUP_TIMEOUT_SECONDS=60
BOT_STATE_DIRECTORY=/var/lib/chatgptviadiscord/state

# Enable after enabling Message Content and Server Members intents in Discord.
CHATGPT_ENABLED=false
CHATGPT_CALLBACK_PORT=1455
CHATGPT_REQUEST_TIMEOUT_SECONDS=180
# Optional bootstrap; persisted /gvd accept settings take priority.
DISCORD_AI_ROLE_ID=

# Experimental read-only quota lookup; separate Codex login with the same email as the Bot.
CODEX_USAGE_ENABLED=true
CODEX_USAGE_EXECUTABLE=/usr/local/bin/codex
CODEX_USAGE_HOME=/var/lib/chatgptviadiscord/codex-usage
CODEX_USAGE_TIMEOUT_SECONDS=20
