CHATGPT_ENABLED=false
CHATGPT_CALLBACK_PORT=1455
CHATGPT_REQUEST_TIMEOUT_SECONDS=180
# Optional bootstrap; persisted /gvd accept settings take priority.
DISCORD_AI_ROLE_ID=
