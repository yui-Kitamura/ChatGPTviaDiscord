# Copy to config/application.properties and restrict access to the local user.
# Never commit the real token. Environment variables override these properties.
discord.bot.token=
discord.guild.id=
bot.startup.timeout.seconds=60
bot.state.directory=state

# Enable only after enabling Message Content and Server Members intents in Discord.
chatgpt.enabled=false
chatgpt.callback.port=1455
chatgpt.request.timeout.seconds=180
# Prefer /gvd accept role:@role; this is only an optional initial value.
discord.ai.role.id=
# Experimental quota lookup (Codex must be logged in separately with the Bot account).
codex.usage.enabled=false
codex.usage.executable=/usr/local/bin/codex
codex.usage.home=/var/lib/chatgptviadiscord/codex-usage
codex.usage.timeout.seconds=20
